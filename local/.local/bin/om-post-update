#!/usr/bin/bash
# om-post-update — reconcile the awesome/quickshell desktop with an
# OpenMandriva system update.
#
# Safe and IDEMPOTENT: run it before an update, after one, or any time. It
# checks each known breakage, fixes what it can, and reports what it cannot.
#
# Run it BEFORE the update as well as after. The lgi patch below is written to
# handle both the old and the new shape, so applying it early costs nothing and
# means the machine never boots into the broken state — which matters, because
# the failure mode is "awesome will not start at all" and recovery needs a TTY.
#
# Background: the 2026-09-14 update on the desktop (maximus) took awesome out
# completely and stopped espanso expanding. Both were system libraries moving
# while something depending on them did not. See the notes under each check.

set -uo pipefail

red()  { printf '\033[0;31m%s\033[0m\n' "$*"; }
grn()  { printf '\033[0;32m%s\033[0m\n' "$*"; }
ylw()  { printf '\033[0;33m%s\033[0m\n' "$*"; }
blu()  { printf '\033[0;34m%s\033[0m\n' "$*"; }
box()  { echo; blu "╔══════════════════════════════════════╗"
              blu "║ $(printf '%-36s' "$1") ║"
              blu "╚══════════════════════════════════════╝"; echo; }
ok()   { grn "  ok   $*"; }
warn() { ylw "  warn $*"; }
bad()  { red "  FAIL $*"; }
info() { printf '       %s\n' "$*"; }

PROBLEMS=0

# ── What counts as "desktop-critical" ────────────────────────────────────
# ONE watch set, used twice by update.sh (via this script):
#   --preflight      the transaction dnf is ABOUT to run (dry run)
#   --needs-check ID the transaction dnf ACTUALLY ran (dnf history)
#   --last-txn       newest transaction id (update.sh compares before/after)
# Each pattern is a full-match extended regex over package NAMES. The comment
# says what it cost here, because "why is this on the list" is the first thing
# forgotten.
ESPANSO=/opt/espanso/espanso      # AM AppImage; not on PATH in every shell
# Qt: quickshell links Qt PRIVATE APIs, so it must be REBUILT per Qt minor.
QT_RE='lib64Qt6(Core|Gui|Qml|Quick|Widgets)|qt6-qtbase.*'
# glib / gobject-introspection: broke lgi 2026-09-14 and awesome would not
# start at all (the 2026-11-15 glib 2.90 / GI 1.86 move is the same risk).
GLIB_RE='lib64glib2\.0.*|libglib2\.0.*|glib2.*|gobject-introspection|lib64girepository.*|libgirepository.*'
# lua + lua-lgi: lgi's /usr/share/lua/*/lgi/ffi.lua is hand-patched, and every
# lua-lgi release overwrites the patch.
LUA_RE='lua[0-9.]*|lib64lua.*|liblua.*|lua-lgi'
# xlibre / amdgpu DDX: xlibre 25.2.3 + the packaged amdgpu driver segfaulted on
# any rotated output; the driver is moved aside here and a package can restore it.
XORG_RE='xlibre.*|x11-driver-video-amdgpu'
# systemd: espanso's AppImage bundles libsystemd (tops out at LIBSYSTEMD_252).
SYSD_RE='systemd|lib64systemd|libsystemd'
# Anything here being REMOVED or DOWNGRADED is flagged: each is load-bearing
# for the session, and a distro-sync --allowerasing can drop one silently.
CRIT_RE='awesome|quickshell(-.*)?|picom|lua-lgi|lxqt-policykit|kf6-kwallet|kwallet-pam|qt6ct|spectacle|proton-pass|i3lock-color|rofi'
# Post-update only (never a preflight prompt): packages that have broken
# nothing by themselves but whose changes the full check verifies: sddm and pam
# can replace the hand-edited /etc/pam.d/sddm and sddm.conf.d (.rpmnew/.rpmsave),
# mesa can take picom's glx backend down, and the Qt theme plugins decide how
# tray menus look.
POST_RE='sddm|pam|mesa|lib64dri-drivers|lib64(GLX|EGL)_mesa.*|plasma-integration|qt-theme-kvantum'

# A transaction as TSV rows  <Action>\t<name>\t<version-release>  sorted by
# name, so output is deterministic. Action is Install/Upgrade/Downgrade/Remove/
# Reinstall, or Replaced for the OLD half of an upgrade (kept only so versions
# can be compared). Two front-ends feed it: dnf's dry run and dnf history.
txn_tsv_history() {
    dnf history info "$1" 2>/dev/null | awk '
        /^  Action/ { f = 1; next }
        f && $1 ~ /^(Install|Upgrade|Downgrade|Remove|Replaced|Reinstall)$/ {
            p = $2; sub(/\.[^.]+$/, "", p)              # drop .arch
            if (match(p, /-[0-9]+:/))                   # name-EPOCH:ver-rel
                print $1 "\t" substr(p, 1, RSTART - 1) "\t" substr(p, RSTART + RLENGTH)
        }' | sort -s -t "$(printf '\t')" -k2,2
}

# dnf5's transaction table. Section headers end in ":"; rows start with a
# space; the old half of an upgrade is an indented "replacing <pkg> ..." row.
# If fewer rows parse than the Transaction Summary promises, say so (ERR) —
# a half-parsed list would read as "clean" and that is the worst failure here.
txn_tsv_dnf5() {
    awk '
        /^Transaction Summary:/ { sum = 1; next }
        sum && $1 ~ /^(Installing|Upgrading|Downgrading|Removing|Reinstalling):$/ { want += $2; next }
        !sum && /^[A-Za-z].*:$/ {
            h = tolower($0)
            act = h ~ /^installing/ ? "Install" : h ~ /^upgrading/ ? "Upgrade" : \
                  h ~ /^downgrading/ ? "Downgrade" : h ~ /^removing/ ? "Remove" : \
                  h ~ /^reinstalling/ ? "Reinstall" : "Skip"
            next
        }
        !sum && /^ / && NF >= 4 && act != "" {
            if ($1 == "replacing") { n = $2; v = $4; a = "Replaced" }
            else                   { n = $1; v = $3; a = act; if (a != "Skip") got++ }
            sub(/^[0-9]+:/, "", v)
            if (a != "Skip") print a "\t" n "\t" v
        }
        END { if (got < want) print "ERR\tparsed " got+0 " of " want " package rows" }
    ' | sort -s -t "$(printf '\t')" -k2,2
}

# classify MODE <tsv on stdin>  ->  FLAG|WARN|NOTE <tab> text   (MODE: pre|post)
#   pre : "would this update hurt?"  Qt only counts when quickshell is NOT
#         coming along, and critical packages only on removal/downgrade.
#   post: "did anything the desktop depends on change?"  Any Qt move counts,
#         and any touch of a critical package does.
# Python and systemd only count when the MINOR / MAJOR version changes: patch
# bumps neither strand pip/pipx venvs nor move libsystemd's symbol versions.
classify() {
    QT="^($QT_RE)\$" GLIB="^($GLIB_RE)\$" LUA="^($LUA_RE)\$" XORG="^($XORG_RE)\$" \
    SYSD="^($SYSD_RE)\$" CRIT="^($CRIT_RE)\$" POST="^($POST_RE)\$" ESP="$([ -x "$ESPANSO" ] && echo 1 || echo 0)" \
    awk -F'\t' -v mode="$1" '
    function minor(v,  p) { split(v, p, "."); return p[1] "." p[2] }
    function major(v,  p) { split(v, p, /[.-]/); return p[1] }
    function add(c, n) { if (++cnt[c] <= 4) lst[c] = lst[c] (lst[c] == "" ? "" : " ") n }
    function names(c) { return lst[c] (cnt[c] > 4 ? " (+" cnt[c] - 4 " more)" : "") }
    function out(k, t) { print k "\t" t }
    $1 == "Replaced" { old[$2] = $3; next }
    $1 == "" { next }
    { if (!($2 in act)) order[++N] = $2; act[$2] = $1; new[$2] = $3 }
    END {
        for (i = 1; i <= N; i++) {
            n = order[i]; a = act[n]; moved = (a != "Install")
            if (n ~ /^quickshell/) qs = 1
            if (moved && n ~ ENVIRON["QT"])   add("qt", n)
            if (moved && n ~ ENVIRON["GLIB"]) add("glib", n)
            if (moved && n ~ ENVIRON["LUA"])  add("lua", n)
            if (moved && n ~ ENVIRON["XORG"]) add("xorg", n)
            if (n == "python" && (a == "Upgrade" || a == "Downgrade") && (n in old) \
                && minor(old[n]) != minor(new[n])) { pyold = minor(old[n]); pynew = minor(new[n]) }
            if (n ~ ENVIRON["SYSD"] && moved && ENVIRON["ESP"] == 1 && (n in old) \
                && major(old[n]) != major(new[n])) { sdold = major(old[n]); sdnew = major(new[n]) }
            if (n ~ ENVIRON["CRIT"] && n !~ ENVIRON["LUA"] \
                && (mode == "post" || a == "Remove" || a == "Downgrade")) add("crit", a " " n)
            if (mode == "post" && n ~ ENVIRON["POST"]) add("post", n)
        }
        if (cnt["qt"]) {
            if (mode == "post")  out("FLAG", "Qt changed: " names("qt"))
            else if (!qs)        out("FLAG", "Qt moves (" names("qt") ") and quickshell is NOT in the transaction — it links Qt private APIs and must be rebuilt, or its bar sections will lay out but paint nothing")
            else                 out("NOTE", "Qt moves (" names("qt") ") and quickshell comes with it — confirm after updating that its Qt matches")
        }
        if (cnt["glib"]) out("FLAG", "glib / gobject-introspection: " names("glib") " — this broke lgi on 2026-09-14 and awesome would not start at all")
        if (cnt["lua"])  out("FLAG", "lua / lua-lgi: " names("lua") " — lgi is hand-patched and a new lua-lgi overwrites the patch")
        if (cnt["xorg"]) out("FLAG", "X server / video driver: " names("xorg") " — the amdgpu DDX crashes X on a rotated output and may be restored")
        if (pynew != "") out("FLAG", "python " pyold " -> " pynew " — pipx/pip --user venvs built for " pyold " stop working (trash-put, udiskie, rofimoji)")
        if (sdnew != "") out(mode == "post" ? "FLAG" : "WARN", "systemd major " sdold " -> " sdnew " — espanso bundles libsystemd (tops out at LIBSYSTEMD_252); verify it still starts")
        if (cnt["crit"]) out("FLAG", (mode == "post" ? "critical package changed: " : "critical package REMOVED or DOWNGRADED: ") names("crit"))
        if (cnt["post"]) out("FLAG", "login / graphics / Qt theme: " names("post") " — re-check the /etc hand edits, compositor and theme")
    }'
}

# Newest dnf transaction id (empty if the history is unreadable).
last_txn_id() { dnf history list 2>/dev/null | awk '$1 ~ /^[0-9]+$/ { print $1; exit }'; }

# ── --needs-check ID: did the transaction that RAN touch the watch set? ───
# Exit 0 = yes (run the full checks), 1 = no (skip), 2 = could not tell.
# Judged from `dnf history info`, i.e. what ACTUALLY changed, not from what the
# preflight predicted: a transaction can differ (--allowerasing, a mirror
# moving between the dry run and the real run).
needs_check() {
    local id=$1 tsv res
    [ -n "$id" ] || { echo "no transaction id" >&2; return 2; }
    tsv=$(txn_tsv_history "$id")
    [ -n "$tsv" ] || { echo "transaction $id has no readable package list" >&2; return 2; }
    res=$(printf '%s\n' "$tsv" | classify post | grep '^FLAG')
    if [ -n "$res" ]; then
        printf '%s\n' "$res" | cut -f2 | sed 's/^/  - /'
        return 0
    fi
    return 1
}

# ── --preflight [FILE]: what is in the PENDING update that has hurt before? ─
# The rest of this script checks whether the desktop still works — after the
# fact, by definition. This is the other half: dnf's own dry run gives the REAL
# transaction (including what --allowerasing would remove and what a
# distro-sync would downgrade, which `dnf check-update` cannot show), and it is
# read against the watch set above BEFORE anything is applied.
#
# `--assumeno` aborts, so a non-zero dnf exit is EXPECTED; success or failure is
# judged from the output. Runs as the user, no sudo (dnf5 can read the repo
# metadata and rpmdb unprivileged).
#
# Exit: 0 = clean, 1 = something flagged, 2 = could not inspect the update.
# FILE (testing) parses a saved dry-run output instead of running dnf.
preflight() {
    local out tsv res flags=0 line
    box "pending update"
    if [ -n "${1:-}" ]; then
        out=$(cat "$1") || { bad "cannot read $1"; return 2; }
    else
        command -v dnf >/dev/null 2>&1 || { bad "no dnf — cannot inspect the pending update"; return 2; }
        out=$(dnf distro-sync --allowerasing --refresh --assumeno 2>&1)
    fi
    if printf '%s\n' "$out" | grep -q '^Nothing to do'; then
        ok "nothing to update"; return 0
    fi
    if ! printf '%s\n' "$out" | grep -q '^Transaction Summary:'; then
        bad "dnf did not produce a transaction summary (network? broken repo?):"
        printf '%s\n' "$out" | tail -5 | sed 's/^/       /'
        return 2
    fi
    tsv=$(printf '%s\n' "$out" | txn_tsv_dnf5)
    if printf '%s\n' "$tsv" | grep -q '^ERR'; then
        bad "could not read dnf's transaction table: $(printf '%s\n' "$tsv" | grep '^ERR' | cut -f2)"
        return 2
    fi
    info "$(printf '%s\n' "$tsv" | awk -F'\t' '$1!="Replaced"{c[$1]++} END{for(k in c) printf "%s %d  ", k, c[k]}')"
    echo
    res=$(printf '%s\n' "$tsv" | classify pre)
    while IFS=$'\t' read -r kind line; do
        case "$kind" in
            FLAG) flags=$((flags + 1)); red "  !! $line" ;;
            WARN) ylw "  !  $line" ;;
            NOTE) info "$line" ;;
        esac
    done <<<"$res"
    echo
    if [ "$flags" -eq 0 ]; then
        ok "nothing in this update is on the watch list"
        return 0
    fi
    ylw "  $flags item(s) above have caused trouble here before."
    return 1
}

case "${1:-}" in
    --preflight)   preflight "${2:-}"; exit $? ;;
    --needs-check) needs_check "${2:-}"; exit $? ;;
    --last-txn)    id=$(last_txn_id); [ -n "$id" ] && echo "$id"; exit $(( id ? 0 : 1 )) ;;
esac

# sudo for the fixes below. Inside dsync the update has just authenticated it;
# `-n` makes that the cheap, silent path. Only fall back to a prompt when there
# is a terminal to answer it — a piped run must fail loudly, not hang.
have_sudo() { sudo -n true 2>/dev/null || { [ -t 0 ] && sudo -v 2>/dev/null; }; }

MARKER='om-post-update: handle both EnumClass.values shapes'

# ── 1. lgi vs gobject-introspection ──────────────────────────────────────
# glib 2.88 / gobject-introspection 1.86 marshal GObject.EnumClass.values as a
# 1-based table of records; lgi 0.9.2 expects a raw array pointer and calls
# core.record.fromarray on it. The mismatch kills lgi's cairo override, which
# kills gears/color.lua, which kills awesome at rc.lua's `require "gears"` —
# for EVERY config including the stock /etc/xdg/awesome/rc.lua.
box "lgi / gobject-introspection"

FFI=""
for c in /usr/share/lua/*/lgi/ffi.lua; do [ -f "$c" ] && FFI="$c" && break; done

# Test before touching anything. Detecting "is it patched" by looking for a
# marker is wrong: a hand-applied fix, a future upstream fix or a package
# update would all be missed, and we would re-patch a working file. Whether
# lgi actually WORKS is the only question that matters.
lgi_works() {
    lua5.4 -e 'local l=require("lgi"); local c=l.cairo; assert(c.Status.SUCCESS==0)' 2>/dev/null
}

if [ -z "$FFI" ]; then
    warn "lgi not installed — skipping (awesome needs it, so this is odd)"
elif lgi_works; then
    ok "lgi loads cairo — nothing to patch"
    PATCHED=skip
    # A new lua-lgi overwrites the hand patch. If it moved and lgi still works,
    # the new build carries its own fix: verify only, never re-patch a working
    # lgi (the patch is anchored on the OLD text and would just fail).
    if dnf history info "$(last_txn_id)" 2>/dev/null | grep -qE '^  (Upgrade|Downgrade|Install) +lua-lgi-'; then
        info "lua-lgi changed in the last transaction; the new build works, left as is"
    fi
else
    bad "lgi cannot load cairo; awesome would not start"

    info "patching $FFI"
    if ! have_sudo; then
        bad "need sudo to patch lgi; re-run when you can authenticate"
        PROBLEMS=$((PROBLEMS + 1))
    else
        sudo cp -n "$FFI" "$FFI.bak-om-post-update" 2>/dev/null
        if sudo python3 - "$FFI" "$MARKER" <<'PY'
import sys, pathlib
path, marker = sys.argv[1], sys.argv[2]
p = pathlib.Path(path); t = p.read_text()
old = """   for i = 0, enum_class.n_values - 1 do
      local val = core.record.fromarray(enum_class.values, i)
      enum_component[core.upcase(val.value_nick):gsub('%-', '_')] = val.value
   end"""
new = """   -- {marker}
   -- glib 2.88 / gobject-introspection 1.86 hand back a 1-based table of
   -- records; older versions hand back a raw array pointer that has to be
   -- indexed with core.record.fromarray. Support both, so this is safe to
   -- apply before or after the update.
   local values = enum_class.values
   local as_table = type(values) == 'table'
   for i = 0, enum_class.n_values - 1 do
      local val = as_table and values[i + 1]
                          or core.record.fromarray(values, i)
      -- The table path yields floats where the array path gave integers.
      local v = val.value
      if as_table then v = math.tointeger(v) or v end
      enum_component[core.upcase(val.value_nick):gsub('%-', '_')] = v
   end""".replace("{marker}", marker)
if marker in t:
    sys.exit(0)
if old not in t:
    sys.stderr.write("anchor not found — lgi may have changed; patch by hand\n")
    sys.exit(1)
p.write_text(t.replace(old, new, 1))
PY
        then ok "patched (backup: $FFI.bak-om-post-update)"
        else bad "could not patch lgi — see message above"; PROBLEMS=$((PROBLEMS + 1)); fi
    fi
fi

# Verify for real. `awesome -k` is NOT proof: it only parses Lua and never
# loads lgi, so it reported "syntax OK" throughout the outage.
if [ -n "$FFI" ] && [ "${PATCHED:-}" != skip ]; then
    if lgi_works; then
        ok "lgi loads cairo after patching (Status.SUCCESS == 0)"
    else
        bad "lgi still cannot load cairo — awesome will NOT start"
        lua5.4 -e 'local l=require("lgi"); local c=l.cairo' 2>&1 | head -3 | sed 's/^/       /'
        PROBLEMS=$((PROBLEMS + 1))
    fi
fi

if [ -n "$FFI" ]; then
    # Captured to a variable, NOT piped: this probe is EXPECTED to exit
    # non-zero (gears needs the awesome global, absent outside the process),
    # and `set -o pipefail` would report the whole pipeline as failed even
    # when the grep matched.
    gears_out=$(LUA_PATH='/usr/share/awesome/lib/?.lua;/usr/share/awesome/lib/?/init.lua;;' \
                lua5.4 -e 'require("gears")' 2>&1 || true)
    case "$gears_out" in
        *"field 'awesome'"*)
            ok "awesome's gears loads (stops only at the awesome global, as expected)" ;;
        *cairo*|*lgi*)
            bad "gears still fails inside lgi/cairo — awesome will NOT start"
            printf '%s\n' "$gears_out" | head -3 | sed 's/^/       /'
            PROBLEMS=$((PROBLEMS + 1)) ;;
        *)
            warn "gears check inconclusive:"
            printf '%s\n' "$gears_out" | head -3 | sed 's/^/       /' ;;
    esac
fi

# ── 2. espanso: bundled libsystemd vs the host's libmount ────────────────
# The AppImage bundles a libsystemd; the host's own libmount.so.1 gets handed
# that stale copy because the AppImage's lib dir wins the search. If the bundle
# predates the symbol versions libmount now wants, the loader dies before
# espanso runs. AM-managed (/opt/espanso), so `am -u` updates it — but only when
# upstream ships a newer AppImage, which can lag a systemd bump. The binary is
# tested by path: /opt/espanso is not on PATH in every shell (dsync's, cron's).
box "espanso"

if [ -x "$ESPANSO" ]; then :; elif command -v espanso >/dev/null 2>&1; then ESPANSO=$(command -v espanso); else ESPANSO=""; fi
if [ -z "$ESPANSO" ]; then
    ok "espanso not installed — skipping"
else
    if "$ESPANSO" --version >/dev/null 2>&1; then
        ok "runs fine: $("$ESPANSO" --version 2>/dev/null | head -1)"
    elif "$ESPANSO" --version 2>&1 | grep -q 'LIBSYSTEMD'; then
        bad "bundled libsystemd is too old for this host's libmount"
        "$ESPANSO" --version 2>&1 | grep 'LIBSYSTEMD' | head -2 | sed 's/^/       /'
        info "The system library is a strict superset, so preloading it fixes this."
        info "Quick check:  LD_PRELOAD=/lib64/libsystemd.so.0 $ESPANSO --version"
        info "Permanent:    add to ~/.config/systemd/user/espanso.service under [Service]:"
        info "                Environment=LD_PRELOAD=/lib64/libsystemd.so.0"
        info "              then: systemctl --user daemon-reload && systemctl --user restart espanso"
        info "Better:       am -u (a current AppImage, 2.4.1+, bundles a new enough copy)"
        PROBLEMS=$((PROBLEMS + 1))
    else
        warn "espanso failed for some other reason:"
        "$ESPANSO" --version 2>&1 | head -3 | sed 's/^/       /'
    fi
    # `activating` is not `active` — a Restart=on-failure loop looks "enabled
    # and running" at a glance but is dying every few seconds.
    st=$(systemctl --user is-active espanso.service 2>&1)
    case "$st" in
        active)     ok "service: active" ;;
        activating) bad "service: activating — it is restart-looping, not running" ; PROBLEMS=$((PROBLEMS + 1)) ;;
        *)          warn "service: $st" ;;
    esac
fi

# ── 2b. Python CLI tools (pipx) vs the running Python ────────────────────
# A pipx app lives in its own venv, built for the interpreter that created it.
# When the distro moves Python a minor version (3.14 -> 3.15 on 2026-11-15) the
# old interpreter is removed, the venv's python symlink dangles, and every
# launcher in ~/.local/bin still starts and then dies. Three matter here:
# trash-put is what `rm` is aliased to, udiskie is started by awesome's
# autostart to mount USB media (it fails silently), and rofimoji is the emoji
# picker. `pipx reinstall-all` rebuilds every venv on the current Python and
# is cheap and safe. These were pip --user installs before pipx, and a pip
# --user package files itself under ~/.local/lib/pythonX.Y, so the old ones
# are reported (never deleted) below.
#
# udiskie needs the SYSTEM PyGObject, so its venv must be made with
# --system-site-packages. pipx records venv args in the app's metadata and
# `reinstall` replays them (pipx/commands/reinstall.py passes
# venv.pipx_metadata.venv_args), so reinstall-all keeps the flag. The explicit
# fallback below still exists because a venv that LOST the flag fails with a
# GI import error and would otherwise look like an unfixable breakage.
box "python tools (pipx)"

pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)
if [ -z "$pyver" ]; then
    warn "python3 not found — skipping"
else
    # Run the tool rather than look for its files: the launcher exists and
    # looks fine right up until it imports.
    pipx_app_ok() { command -v "$1" >/dev/null 2>&1 && "$1" --version >/dev/null 2>&1; }
    PIPX_APPS="trash-put:trash-cli:rm is aliased to it, so rm is broken
udiskie:udiskie:USB media will not automount
rofimoji:rofimoji:the emoji picker will not start"

    # ~/.local/bin/pipx can be a stale pip --user shim from before the distro
    # package (it imports pipx from the old Python's site-packages), so test
    # that pipx RUNS rather than that the name exists.
    if ! pipx --version >/dev/null 2>&1; then
        warn "pipx is missing or broken — cannot rebuild the Python tools"
        info "Install the distro package:  sudo dnf install python-pipx"
        [ -e "$HOME/.local/bin/pipx" ] && info "A stale ~/.local/bin/pipx shadows it; remove that:  rm ~/.local/bin/pipx"
        while IFS=: read -r cmd pkg why; do
            pipx_app_ok "$cmd" && ok "$cmd runs on Python $pyver" \
                || { command -v "$cmd" >/dev/null 2>&1 && bad "$cmd is broken — $why" && PROBLEMS=$((PROBLEMS + 1)); }
        done <<<"$PIPX_APPS"
    else
        # Rebuild when an app fails OR a venv was built for another minor:
        # an app can still limp along on a dangling-but-present interpreter.
        need=0; stale=""
        while IFS=: read -r cmd pkg why; do
            command -v "$cmd" >/dev/null 2>&1 || continue
            pipx_app_ok "$cmd" || { need=1; stale="$stale $cmd"; }
        done <<<"$PIPX_APPS"
        for cfg in "${PIPX_HOME:-$HOME/.local/share/pipx}"/venvs/*/pyvenv.cfg; do
            [ -f "$cfg" ] || continue
            v=$(sed -n 's/^version\(_info\)\? *= *\([0-9]*\.[0-9]*\).*/\2/p' "$cfg" | head -1)
            [ -n "$v" ] && [ "$v" != "$pyver" ] && { need=1; stale="$stale $(basename "$(dirname "$cfg")")(py$v)"; }
        done
        if [ "$need" -eq 1 ]; then
            warn "pipx apps built for another Python or failing:${stale} (system Python $pyver)"
            info "running: pipx reinstall-all"
            pipx reinstall-all >/dev/null 2>&1 || warn "pipx reinstall-all reported errors"
        fi
        while IFS=: read -r cmd pkg why; do
            if ! command -v "$cmd" >/dev/null 2>&1; then
                warn "$cmd not installed — pipx install $pkg"
            elif pipx_app_ok "$cmd"; then
                ok "$cmd runs on Python $pyver"
            elif [ "$cmd" = udiskie ] \
                 && pipx install --force --system-site-packages udiskie >/dev/null 2>&1 \
                 && pipx_app_ok udiskie; then
                ok "udiskie fixed (reinstalled with --system-site-packages for PyGObject)"
            else
                bad "$cmd still cannot run — $why"
                info "try:  pipx install --force $pkg"
                PROBLEMS=$((PROBLEMS + 1))
            fi
        done <<<"$PIPX_APPS"
    fi

    # Leftovers from the pip --user days. Reported, not touched: rebuilding a
    # torch/numba stack is a decision, not a fix.
    stranded=""
    for d in "$HOME"/.local/lib/python3.*/site-packages; do
        [ -d "$d" ] || continue
        v=${d#"$HOME"/.local/lib/python}; v=${v%/site-packages}
        [ "$v" = "$pyver" ] && continue
        n=$(find "$d" -maxdepth 1 -name '*.dist-info' 2>/dev/null | wc -l)
        [ "$n" -gt 0 ] && stranded="$stranded python$v($n)"
    done
    if [ -n "$stranded" ]; then
        warn "pip --user packages left under an older Python:${stranded}"
        info "Their launchers in ~/.local/bin fail with ModuleNotFoundError."
        info "Reinstall what you still use:  pipx install <name>"
        info "Big stacks (torch, numba, madmom) may want their own venv on an older Python."
    else
        ok "no pip --user packages stranded under another Python"
    fi
fi

# ── 2c. X video driver: the amdgpu DDX must stay moved aside ─────────────
# After the 2026-11-15 update (xlibre 25.2.2 -> 25.2.3) the packaged amdgpu X
# driver, built against the older xlibre, segfaulted in
# amdgpu_screen_damage_report whenever an output was rotated, dropping the
# session back to SDDM. The fix was moving amdgpu_drv.so aside so X falls
# through to modesetting. (OutputClass overrides do NOT work: X loads both the
# stock rule and the override and amdgpu wins whenever it initialises.)
# x11-driver-video-amdgpu can put the file back on any update, and then the
# crash returns with no warning.
#
# Machine-specific on purpose: it only acts where the file was moved aside
# before, and then FIXES it (a warning nobody reads is how the crash came back
# unannounced). The .disabled copy is the marker — the package does not own
# it, so it survives an update that restores the real driver.
box "X video driver"

drv=""; off=""
for f in /usr/lib64/xorg/modules/*/drivers/video/amdgpu_drv.so; do
    [ -f "$f" ] && drv=$f && break
done
for f in /usr/lib64/xorg/modules/*/drivers/video/amdgpu_drv.so.disabled; do
    [ -f "$f" ] && off=$f && break
done
if [ -n "$off" ] && [ -n "$drv" ]; then
    warn "the amdgpu X driver is back: $drv (a package update restored it)"
    info "With a rotated output it crashes X to SDDM. Moving it aside again."
    # -f: the .disabled copy is stale by definition (the package owns the new
    # file), so the newest restored driver replaces it as the kept copy.
    if have_sudo && sudo mv -f "$drv" "$drv.disabled" && [ ! -e "$drv" ]; then
        ok "moved aside again (X will use modesetting from the next login)"
        info "(A newer x11-driver-video-amdgpu may have fixed this — test before keeping it off.)"
    else
        bad "could not move it aside — run:  sudo mv -f $drv $drv.disabled"
        PROBLEMS=$((PROBLEMS + 1))
    fi
elif [ -n "$off" ]; then
    ok "amdgpu X driver is still moved aside (X uses modesetting)"
else
    ok "amdgpu X driver was never moved aside here — nothing to check"
fi

# ── 3. quickshell vs Qt — detect only, cannot fix here ───────────────────
# quickshell links Qt private APIs, which are not binary compatible across
# minor releases, so it must be REBUILT (not upgraded) when Qt moves. OM does
# rebuild it per Qt minor (0.2.1-7 matches Qt 6.12) but a Qt bump can land first;
# until that rebuild ships, `rpmbuild --rebuild` on its SRPM is the stopgap. Symptom is a bar section that lays out but paints nothing.
box "quickshell / Qt"

if ! command -v qs >/dev/null 2>&1; then
    ok "quickshell not installed — skipping"
else
    # `qs --version` prints only quickshell's own version, never Qt's. The
    # built-against Qt appears solely in quickshell's own startup warning.
    qslog=$(qs log 2>/dev/null || true)
    built=$(printf '%s\n' "$qslog" | grep -oE 'built against Qt [0-9.]+' | tail -1 | awk '{print $NF}')
    sys=$(rpm -q --qf '%{VERSION}' lib64Qt6Core 2>/dev/null)
    if printf '%s\n' "$qslog" | grep -q 'must be rebuilt'; then
        warn "built against Qt ${built:-?}, system has Qt ${sys:-?} — needs a REBUILD, not an upgrade"
        info "Expect bar sections that occupy space but draw nothing. Recovery: Super+B."
        info "Real fix:  dnf download --source quickshell && rpmbuild --rebuild quickshell-*.src.rpm"
        info "           (bump the release so dnf does not swap yours back out)"
    elif [ -z "$qslog" ]; then
        warn "no quickshell log yet — re-run this after starting the session"
        info "system Qt is ${sys:-unknown}"
    else
        ok "no rebuild warning in quickshell's log (system Qt ${sys:-unknown})"
    fi
fi

# ── 4. compositor ────────────────────────────────────────────────────────
# picom losing its start-up race leaves the session with NO compositor and
# says so nowhere. It does not look like "the compositor is missing" either:
# what you notice is conky drawing solid black and a blurred fringe around Qt
# menus, because windows that reserve a transparent margin have nothing
# compositing behind them. Ask X who owns the selection rather than trusting
# the process table — picom can be running and not own it.
box "compositor"

if [ -z "${DISPLAY:-}" ]; then
    ok "no X display — skipping (run this inside the session)"
else
    comp=$(python3 - 2>/dev/null <<'PY'
from Xlib import display
d = display.Display()
print('1' if d.get_selection_owner(d.get_atom('_NET_WM_CM_S0')) else '0')
PY
)
    case "${comp:-}" in
        1) ok "a compositor owns _NET_WM_CM_S0" ;;
        0) bad "NO compositor is running — no blur, no transparency"
           info "Start it:  picom --config ~/.config/picom/picom.conf --daemon"
           info "If that exits 1 with 'Another composite manager is already"
           info "running', something else holds the slot: pkill -x xcompmgr."
           info "If it fails on glx (after a mesa update), switch picom.conf to"
           info "backend = \"xrender\" and remove the blur section."
           PROBLEMS=$((PROBLEMS + 1)) ;;
        *) warn "could not ask X (python-xlib missing?) — skipped" ;;
    esac
fi

# ── 5. Qt platform theme ─────────────────────────────────────────────────
# A platform theme plugin built against an older Qt stays on disk and is
# ignored in silence; Qt falls back to Fusion's light palette and empty icon
# theme. Symptom is grey tray right-click menus on a dark desktop plus
# missing icons in Qt dialogs. ~/.xprofile picks whichever of qt6ct/kde Qt
# can actually load, so the question here is whether that choice still holds.
box "Qt platform theme"

theme="${QT_QPA_PLATFORMTHEME:-}"
if ! command -v qtdiag6 >/dev/null 2>&1; then
    warn "qtdiag6 not installed — cannot verify (install qt6-qtbase-tools)"
elif [ -z "$theme" ]; then
    warn "QT_QPA_PLATFORMTHEME is unset — is ~/.xprofile being sourced?"
    PROBLEMS=$((PROBLEMS + 1))
else
    avail=$(QT_QPA_PLATFORM=offscreen qtdiag6 2>/dev/null \
            | sed -n '/^Theme:/,/^$/p' \
            | sed -n 's/.*available *: *//p' | head -1 | tr -d ' ')
    case ",$avail," in
        *",$theme,"*) ok "Qt can load the selected platform theme ($theme)" ;;
        "",|,,)       warn "qtdiag6 reported no theme list — skipped" ;;
        *)            bad "Qt CANNOT load '$theme' — menus will be light grey"
                      info "available: ${avail:-none}"
                      info "The plugin file exists but Qt rejects it on build version."
                      info "Nothing to fix here: it needs a rebuilt distro package."
                      PROBLEMS=$((PROBLEMS + 1)) ;;
    esac
    # Which widget style loads is a separate question, and it is NOT
    # QT_STYLE_OVERRIDE: plasma-integration applies kdeglobals [KDE]
    # widgetStyle after Qt has honoured the variable.
    ws=$(awk '/^\[KDE\]/{f=1;next} /^\[/{f=0} f&&/^widgetStyle=/{sub(/^widgetStyle=/,"");print;exit}' \
         "${XDG_CONFIG_HOME:-$HOME/.config}/kdeglobals" 2>/dev/null)
    [ -n "$ws" ] && info "kdeglobals [KDE] widgetStyle = $ws (this decides menu shape)"
fi

# ── 6. hand-edited system files ──────────────────────────────────────────
# Two files under /etc are edited by hand on this machine. A package update
# can replace either and leave a .rpmnew behind, silently reverting the fix.
box "hand-edited /etc files"

pamf=/etc/pam.d/sddm
if [ ! -f "$pamf" ]; then
    warn "$pamf missing — unexpected"
else
    sa=$(grep -nE '^session[[:space:]]+include[[:space:]]+system-auth' "$pamf" | head -1 | cut -d: -f1)
    kw=$(grep -nE '^-?session.*pam_kwallet5\.so' "$pamf" | head -1 | cut -d: -f1)
    if [ -z "$kw" ]; then
        warn "no pam_kwallet5 session line in $pamf"
    elif [ -z "$sa" ]; then
        warn "no 'session include system-auth' line in $pamf"
    elif [ "$kw" -gt "$sa" ]; then
        ok "pam_kwallet runs after pam_systemd (line $kw > $sa)"
    else
        bad "pam_kwallet runs BEFORE system-auth (line $kw < $sa) — reverted"
        info "ksecretd then starts with no XDG_RUNTIME_DIR and exits."
        info "Move the pam_kwallet session lines below 'session include system-auth'."
        info "A backup of the fixed file may be at ${pamf}.bak-20260921"
        PROBLEMS=$((PROBLEMS + 1))
    fi
fi

ddc=/etc/sddm.conf.d/10-displayserver.conf
if grep -qs '^DisplayServer=x11$' "$ddc"; then
    ok "sddm pinned to DisplayServer=x11"
else
    bad "$ddc missing or changed — logout will black-screen again"
    info "sddm 0.21 defaults to x11-user, which crashes the greeter on logout."
    info "Recreate it with:  [General]  /  DisplayServer=x11"
    info "Recovery if it happens: Ctrl+Alt+F3, sudo systemctl restart sddm"
    PROBLEMS=$((PROBLEMS + 1))
fi

leftovers=$(find /etc/pam.d /etc/sddm.conf.d -maxdepth 1 \
            \( -name '*.rpmnew' -o -name '*.rpmsave' \) 2>/dev/null)
if [ -n "$leftovers" ]; then
    warn "package updates left these behind — compare them against the live files:"
    printf '%s\n' "$leftovers" | sed 's/^/       /'
else
    ok "no .rpmnew/.rpmsave left under /etc/pam.d or /etc/sddm.conf.d"
fi

# ── 7. secret service ────────────────────────────────────────────────────
# Distinct from the KWallet password prompt. The prompt is a known ksecretd
# bug and merely annoying; the service being ABSENT means Mailspring, Proton
# Bridge and browsers cannot store credentials at all.
box "secret service"

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    ok "no session bus — skipping (run this inside the session)"
elif gdbus call --session --dest org.freedesktop.DBus \
        --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.NameHasOwner org.freedesktop.secrets \
        2>/dev/null | grep -q true; then
    ok "org.freedesktop.secrets is served"
    if journalctl -b -t ensure-secret-service --no-pager 2>/dev/null \
         | grep -q "unlocked via kwallet-pam handoff"; then
        ok "unlocked by kwallet-pam — no password prompt this login"
    else
        info "served by the fallback, so KWallet asked for a password once."
        info "Known ksecretd pam-login bug; not fixable from this side."
    fi
else
    bad "org.freedesktop.secrets has NO owner — credential storage is broken"
    info "Run:  ~/.local/bin/ensure-secret-service"
    PROBLEMS=$((PROBLEMS + 1))
fi

# ── 8. is a reboot required, and how urgently ────────────────────────────
# This is the check that was missing, and it is the one that matters most
# right after an update. On 2026-09-14 every known breakage had been handled
# and awesome was fine, yet the session went black mid-afternoon: glib and Qt
# had been REPLACED underneath running processes, and quickshell (902
# mapped-but-deleted regions) aborted the moment it needed a fresh page,
# taking the wallpaper and bar with it. Nothing reports that state; you have
# to go looking. A library update leaves every running process holding files
# that no longer exist, and glibc in particular is linked by everything.
box "reboot needed?"

REBOOT=0

running_kernel=$(uname -r)
newest_kernel=$(rpm -q --qf '%{VERSION}-%{RELEASE}\n' kernel-desktop 2>/dev/null | sort -V | tail -1)
if [ -n "$newest_kernel" ] && [ "${running_kernel%%-*}" != "${newest_kernel%%-*}" ]; then
    warn "kernel: running ${running_kernel}, installed ${newest_kernel}"
    info "the new kernel and its firmware are not active until you reboot"
    REBOOT=1
else
    ok "kernel: running the newest installed (${running_kernel})"
fi

# Count processes holding replaced libraries. Capped so this stays fast on a
# busy session; the count only needs to be indicative, not exact.
stale=0; worst=""; worstn=0
for pid in $(pgrep -u "$USER" . 2>/dev/null | head -400); do
    n=$(grep -c '(deleted)' "/proc/$pid/maps" 2>/dev/null) || continue
    case "$n" in ''|0) continue ;; esac
    stale=$((stale + 1))
    if [ "$n" -gt "$worstn" ]; then
        worstn=$n
        worst="$(ps -o comm= -p "$pid" 2>/dev/null) (pid $pid)"
    fi
done

if [ "$stale" -eq 0 ]; then
    ok "no processes are holding replaced libraries"
else
    warn "$stale process(es) are running on libraries that no longer exist"
    [ -n "$worst" ] && info "worst: $worst with $worstn mapped-but-deleted regions"
    info "They work until they touch something needing a fresh page, then die."
    info "quickshell going this way is what blacked out the session on 2026-09-14."
    REBOOT=1
fi

if [ "$REBOOT" -eq 1 ]; then
    ylw "  --> REBOOT once the checks above are clean."
fi

# ── Summary ──────────────────────────────────────────────────────────────
echo
if [ "$PROBLEMS" -eq 0 ]; then
    if [ "${REBOOT:-0}" -eq 1 ]; then
        ylw "╔════════════════════════════════════════════╗"
        ylw "║ Nothing broken, but a REBOOT is needed      ║"
        ylw "╚════════════════════════════════════════════╝"
    else
        grn "╔════════════════════════════════════════════╗"
        grn "║ Nothing outstanding, no reboot needed       ║"
        grn "╚════════════════════════════════════════════╝"
    fi
else
    red "╔═════════════════════════════════════╗"
    red "║ $(printf '%-35s' "$PROBLEMS item(s) need attention above") ║"
    red "╚═════════════════════════════════════╝"
    echo
    ylw "  Do NOT reboot into awesome until the lgi check passes — if it fails,"
    ylw "  awesome will not start and you will need a TTY (Ctrl+Alt+F2) to recover."
    ylw "  Session log, which SDDM overwrites on every login:"
    info "cp ~/.local/share/sddm/xorg-session.log /tmp/awesome-fail.log"
fi
echo
exit "$PROBLEMS"
