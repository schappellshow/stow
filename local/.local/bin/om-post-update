#!/usr/bin/bash
# om-post-update — reconcile the awesome/quickshell desktop with an
# OpenMandriva system update.
#
# Safe and IDEMPOTENT: run it before an update, after one, or any time. It
# checks each known breakage, fixes what it can, and reports what it cannot.
#
# Run it BEFORE the update as well as after. The lgi patch below is written to
# handle both the old and the new shape, so applying it early costs nothing and
# means the machine never boots into the broken state — which matters, because
# the failure mode is "awesome will not start at all" and recovery needs a TTY.
#
# Background: the 2026-09-14 update on the desktop (maximus) took awesome out
# completely and stopped espanso expanding. Both were system libraries moving
# while something depending on them did not. See the notes under each check.

set -uo pipefail

red()  { printf '\033[0;31m%s\033[0m\n' "$*"; }
grn()  { printf '\033[0;32m%s\033[0m\n' "$*"; }
ylw()  { printf '\033[0;33m%s\033[0m\n' "$*"; }
blu()  { printf '\033[0;34m%s\033[0m\n' "$*"; }
box()  { echo; blu "╔══════════════════════════════════════╗"
              blu "║ $(printf '%-36s' "$1") ║"
              blu "╚══════════════════════════════════════╝"; echo; }
ok()   { grn "  ok   $*"; }
warn() { ylw "  warn $*"; }
bad()  { red "  FAIL $*"; }
info() { printf '       %s\n' "$*"; }

PROBLEMS=0

# ── --preflight: what is in the PENDING update that has hurt before? ─────
# The rest of this script checks whether the desktop still works. That is
# after the fact by definition: every check below exists because something
# already broke once. This mode is the other half — read the pending update
# against the packages that have historically mattered on this machine, so a
# risky one is known BEFORE it is applied rather than diagnosed afterwards.
#
# It predicts nothing. It only says "this package is in the update, and here
# is what it cost you last time".
preflight() {
    box "pending update"
    if ! command -v dnf >/dev/null 2>&1; then
        bad "no dnf — cannot inspect the pending update"; return 1
    fi
    # dnf5 prints an "Upgrades" header and repo-progress lines alongside the
    # table, so match the SHAPE of a package row instead of "starts with a
    # letter": exactly three fields, with name.arch in the first. Anything
    # looser counts the header as a package.
    pending=$(dnf check-update --refresh 2>/dev/null \
              | awk 'NF==3 && $1 ~ /\./ { sub(/\.[^.]+$/, "", $1); print $1 }' \
              | sort -u)
    if [ -z "$pending" ]; then
        ok "nothing to update"; return 0
    fi
    info "$(printf '%s\n' "$pending" | wc -l) package(s) pending"
    echo

    hits=0
    # Each line is  <extended regex>::<what it has broken here before>.
    # The separator is :: and NOT | because the patterns themselves use | for
    # alternation, and splitting on that would cut every pattern at its first
    # branch and silently match almost nothing.
    while IFS= read -r line; do
        case "$line" in ''|'#'*) continue ;; esac
        pat=${line%%::*}
        note=${line#*::}
        match=$(printf '%s\n' "$pending" | grep -iE "^($pat)$" | tr '\n' ' ')
        [ -n "$match" ] || continue
        hits=$((hits + 1))
        ylw "  !! $match"
        printf '       %s\n' "$note"
    done <<'WATCHLIST'
qt6-qtbase.*|lib64Qt6.*::quickshell links Qt PRIVATE APIs and must be REBUILT, not upgraded. Symptom: bar sections occupy space but paint nothing. Recovery Super+B; real fix is rpmbuild --rebuild on its SRPM.
qt6ct::GOOD NEWS if this is a rebuild: ~/.xprofile prefers qt6ct whenever Qt can load it, so a fixed package is picked up automatically. Verify with the Qt platform theme check below.
gobject-introspection|lib64girepository.*|glib2.0|lib64glib2.0.*::Broke lgi 2026-09-14 and awesome would not start AT ALL. Run this script (without --preflight) BEFORE rebooting; the lgi patch is safe to apply early.
mesa|lib64dri-drivers|libdri-drivers|lib64gbm|libgbm|lib64EGL_mesa|lib64GLX_mesa::picom uses backend = "glx". If glx breaks, picom exits and you get NO compositor: no blur, opaque conky, odd fringes on menus. Fallback is backend = "xrender" with the blur section removed.
sddm::Default DisplayServer=x11-user crashed the greeter on logout (black screen + cursor). /etc/sddm.conf.d/10-displayserver.conf pins x11 — check it survived, and that the file was not replaced.
pam|kwallet-pam::/etc/pam.d/sddm is hand-edited: pam_kwallet must come AFTER "session include system-auth". A package replacing that file silently reverts it. Look for .rpmnew/.rpmsave afterwards.
kf6-kwallet|kwallet::ksecretd owns the secret service. Its pam-login path is currently broken (prompts once per login); a fix here would be welcome news worth re-testing.
pipewire|lib64pipewire|libpipewire|pipewire-pulse::Do-Not-Disturb event-sound filtering keys off media.role, and audio auto-switching watches node changes. A minor bump can move those properties.
systemd|lib64systemd.*::espanso's AppImage bundles its own libsystemd and dies when the host's libmount moves past it. See the espanso check below.
glibc::Linked by everything. Every running process will be holding a deleted copy until you reboot.
xorg-server|xlibre-server|x11-server.*::The X server itself — expect to restart the session.
plasma-integration|breeze|kvantum|qt6-style.*::Qt widget style for tray menus. kdeglobals [KDE] widgetStyle decides which one loads, NOT QT_STYLE_OVERRIDE.
awesome::The window manager. Check rc.lua still loads before rebooting into it.
picom::Compositor config compatibility — the wintypes and blur sections have changed shape between releases.
networkmanager|lib64nm0::The bar's network widget talks to NM over D-Bus.
WATCHLIST

    echo
    if [ "$hits" -eq 0 ]; then
        ok "nothing in this update is on the watchlist"
        info "Still worth running this script again afterwards."
    else
        ylw "  $hits item(s) above have caused trouble here before."
        info "None of this means the update WILL break — only where to look if it does."
        info "Run this script again after updating, and before rebooting."
    fi
    echo
    return 0
}

if [ "${1:-}" = "--preflight" ]; then
    preflight
    exit $?
fi

MARKER='om-post-update: handle both EnumClass.values shapes'

# ── 1. lgi vs gobject-introspection ──────────────────────────────────────
# glib 2.88 / gobject-introspection 1.86 marshal GObject.EnumClass.values as a
# 1-based table of records; lgi 0.9.2 expects a raw array pointer and calls
# core.record.fromarray on it. The mismatch kills lgi's cairo override, which
# kills gears/color.lua, which kills awesome at rc.lua's `require "gears"` —
# for EVERY config including the stock /etc/xdg/awesome/rc.lua.
box "lgi / gobject-introspection"

FFI=""
for c in /usr/share/lua/*/lgi/ffi.lua; do [ -f "$c" ] && FFI="$c" && break; done

# Test before touching anything. Detecting "is it patched" by looking for a
# marker is wrong: a hand-applied fix, a future upstream fix or a package
# update would all be missed, and we would re-patch a working file. Whether
# lgi actually WORKS is the only question that matters.
lgi_works() {
    lua5.4 -e 'local l=require("lgi"); local c=l.cairo; assert(c.Status.SUCCESS==0)' 2>/dev/null
}

if [ -z "$FFI" ]; then
    warn "lgi not installed — skipping (awesome needs it, so this is odd)"
elif lgi_works; then
    ok "lgi loads cairo — nothing to patch"
    PATCHED=skip
else
    bad "lgi cannot load cairo; awesome would not start"

    info "patching $FFI"
    if ! sudo -v 2>/dev/null; then
        bad "need sudo to patch lgi; re-run when you can authenticate"
        PROBLEMS=$((PROBLEMS + 1))
    else
        sudo cp -n "$FFI" "$FFI.bak-om-post-update" 2>/dev/null
        if sudo python3 - "$FFI" "$MARKER" <<'PY'
import sys, pathlib
path, marker = sys.argv[1], sys.argv[2]
p = pathlib.Path(path); t = p.read_text()
old = """   for i = 0, enum_class.n_values - 1 do
      local val = core.record.fromarray(enum_class.values, i)
      enum_component[core.upcase(val.value_nick):gsub('%-', '_')] = val.value
   end"""
new = """   -- {marker}
   -- glib 2.88 / gobject-introspection 1.86 hand back a 1-based table of
   -- records; older versions hand back a raw array pointer that has to be
   -- indexed with core.record.fromarray. Support both, so this is safe to
   -- apply before or after the update.
   local values = enum_class.values
   local as_table = type(values) == 'table'
   for i = 0, enum_class.n_values - 1 do
      local val = as_table and values[i + 1]
                          or core.record.fromarray(values, i)
      -- The table path yields floats where the array path gave integers.
      local v = val.value
      if as_table then v = math.tointeger(v) or v end
      enum_component[core.upcase(val.value_nick):gsub('%-', '_')] = v
   end""".replace("{marker}", marker)
if marker in t:
    sys.exit(0)
if old not in t:
    sys.stderr.write("anchor not found — lgi may have changed; patch by hand\n")
    sys.exit(1)
p.write_text(t.replace(old, new, 1))
PY
        then ok "patched (backup: $FFI.bak-om-post-update)"
        else bad "could not patch lgi — see message above"; PROBLEMS=$((PROBLEMS + 1)); fi
    fi
fi

# Verify for real. `awesome -k` is NOT proof: it only parses Lua and never
# loads lgi, so it reported "syntax OK" throughout the outage.
if [ -n "$FFI" ] && [ "${PATCHED:-}" != skip ]; then
    if lgi_works; then
        ok "lgi loads cairo after patching (Status.SUCCESS == 0)"
    else
        bad "lgi still cannot load cairo — awesome will NOT start"
        lua5.4 -e 'local l=require("lgi"); local c=l.cairo' 2>&1 | head -3 | sed 's/^/       /'
        PROBLEMS=$((PROBLEMS + 1))
    fi
fi

if [ -n "$FFI" ]; then
    # Captured to a variable, NOT piped: this probe is EXPECTED to exit
    # non-zero (gears needs the awesome global, absent outside the process),
    # and `set -o pipefail` would report the whole pipeline as failed even
    # when the grep matched.
    gears_out=$(LUA_PATH='/usr/share/awesome/lib/?.lua;/usr/share/awesome/lib/?/init.lua;;' \
                lua5.4 -e 'require("gears")' 2>&1 || true)
    case "$gears_out" in
        *"field 'awesome'"*)
            ok "awesome's gears loads (stops only at the awesome global, as expected)" ;;
        *cairo*|*lgi*)
            bad "gears still fails inside lgi/cairo — awesome will NOT start"
            printf '%s\n' "$gears_out" | head -3 | sed 's/^/       /'
            PROBLEMS=$((PROBLEMS + 1)) ;;
        *)
            warn "gears check inconclusive:"
            printf '%s\n' "$gears_out" | head -3 | sed 's/^/       /' ;;
    esac
fi

# ── 2. espanso: bundled libsystemd vs the host's libmount ────────────────
# The AppImage bundles a libsystemd; the host's own libmount.so.1 gets handed
# that stale copy because the AppImage's lib dir wins the search. If the bundle
# predates the symbol versions libmount now wants, the loader dies before
# espanso runs. Not AM-managed, so `am -u` never updates it.
box "espanso"

if ! command -v espanso >/dev/null 2>&1; then
    ok "espanso not installed — skipping"
else
    if espanso --version >/dev/null 2>&1; then
        ok "runs fine: $(espanso --version 2>/dev/null | head -1)"
    elif espanso --version 2>&1 | grep -q 'LIBSYSTEMD'; then
        bad "bundled libsystemd is too old for this host's libmount"
        espanso --version 2>&1 | grep 'LIBSYSTEMD' | head -2 | sed 's/^/       /'
        info "The system library is a strict superset, so preloading it fixes this."
        info "Quick check:  LD_PRELOAD=/lib64/libsystemd.so.0 espanso --version"
        info "Permanent:    add to ~/.config/systemd/user/espanso.service under [Service]:"
        info "                Environment=LD_PRELOAD=/lib64/libsystemd.so.0"
        info "              then: systemctl --user daemon-reload && systemctl --user restart espanso"
        info "Better:       download a current AppImage (2.4.1+ bundles a new enough copy)"
        PROBLEMS=$((PROBLEMS + 1))
    else
        warn "espanso failed for some other reason:"
        espanso --version 2>&1 | head -3 | sed 's/^/       /'
    fi
    # `activating` is not `active` — a Restart=on-failure loop looks "enabled
    # and running" at a glance but is dying every few seconds.
    st=$(systemctl --user is-active espanso.service 2>&1)
    case "$st" in
        active)     ok "service: active" ;;
        activating) bad "service: activating — it is restart-looping, not running" ; PROBLEMS=$((PROBLEMS + 1)) ;;
        *)          warn "service: $st" ;;
    esac
fi

# ── 3. quickshell vs Qt — detect only, cannot fix here ───────────────────
# quickshell links Qt private APIs, which are not binary compatible across
# minor releases, so it must be REBUILT (not upgraded) when Qt moves. There is
# no packaged rebuild; the fix is `rpmbuild --rebuild` on its SRPM, or waiting
# for OMLx. Symptom is a bar section that lays out but paints nothing.
box "quickshell / Qt"

if ! command -v qs >/dev/null 2>&1; then
    ok "quickshell not installed — skipping"
else
    # `qs --version` prints only quickshell's own version, never Qt's. The
    # built-against Qt appears solely in quickshell's own startup warning.
    qslog=$(qs log 2>/dev/null || true)
    built=$(printf '%s\n' "$qslog" | grep -oE 'built against Qt [0-9.]+' | tail -1 | awk '{print $NF}')
    sys=$(rpm -q --qf '%{VERSION}' lib64Qt6Core 2>/dev/null)
    if printf '%s\n' "$qslog" | grep -q 'must be rebuilt'; then
        warn "built against Qt ${built:-?}, system has Qt ${sys:-?} — needs a REBUILD, not an upgrade"
        info "Expect bar sections that occupy space but draw nothing. Recovery: Super+B."
        info "Real fix:  dnf download --source quickshell && rpmbuild --rebuild quickshell-*.src.rpm"
        info "           (bump the release so dnf does not swap yours back out)"
    elif [ -z "$qslog" ]; then
        warn "no quickshell log yet — re-run this after starting the session"
        info "system Qt is ${sys:-unknown}"
    else
        ok "no rebuild warning in quickshell's log (system Qt ${sys:-unknown})"
    fi
fi

# ── 4. compositor ────────────────────────────────────────────────────────
# picom losing its start-up race leaves the session with NO compositor and
# says so nowhere. It does not look like "the compositor is missing" either:
# what you notice is conky drawing solid black and a blurred fringe around Qt
# menus, because windows that reserve a transparent margin have nothing
# compositing behind them. Ask X who owns the selection rather than trusting
# the process table — picom can be running and not own it.
box "compositor"

if [ -z "${DISPLAY:-}" ]; then
    ok "no X display — skipping (run this inside the session)"
else
    comp=$(python3 - 2>/dev/null <<'PY'
from Xlib import display
d = display.Display()
print('1' if d.get_selection_owner(d.get_atom('_NET_WM_CM_S0')) else '0')
PY
)
    case "${comp:-}" in
        1) ok "a compositor owns _NET_WM_CM_S0" ;;
        0) bad "NO compositor is running — no blur, no transparency"
           info "Start it:  picom --config ~/.config/picom/picom.conf --daemon"
           info "If that exits 1 with 'Another composite manager is already"
           info "running', something else holds the slot: pkill -x xcompmgr."
           info "If it fails on glx (after a mesa update), switch picom.conf to"
           info "backend = \"xrender\" and remove the blur section."
           PROBLEMS=$((PROBLEMS + 1)) ;;
        *) warn "could not ask X (python-xlib missing?) — skipped" ;;
    esac
fi

# ── 5. Qt platform theme ─────────────────────────────────────────────────
# A platform theme plugin built against an older Qt stays on disk and is
# ignored in silence; Qt falls back to Fusion's light palette and empty icon
# theme. Symptom is grey tray right-click menus on a dark desktop plus
# missing icons in Qt dialogs. ~/.xprofile picks whichever of qt6ct/kde Qt
# can actually load, so the question here is whether that choice still holds.
box "Qt platform theme"

theme="${QT_QPA_PLATFORMTHEME:-}"
if ! command -v qtdiag6 >/dev/null 2>&1; then
    warn "qtdiag6 not installed — cannot verify (install qt6-qtbase-tools)"
elif [ -z "$theme" ]; then
    warn "QT_QPA_PLATFORMTHEME is unset — is ~/.xprofile being sourced?"
    PROBLEMS=$((PROBLEMS + 1))
else
    avail=$(QT_QPA_PLATFORM=offscreen qtdiag6 2>/dev/null \
            | sed -n '/^Theme:/,/^$/p' \
            | sed -n 's/.*available *: *//p' | head -1 | tr -d ' ')
    case ",$avail," in
        *",$theme,"*) ok "Qt can load the selected platform theme ($theme)" ;;
        "",|,,)       warn "qtdiag6 reported no theme list — skipped" ;;
        *)            bad "Qt CANNOT load '$theme' — menus will be light grey"
                      info "available: ${avail:-none}"
                      info "The plugin file exists but Qt rejects it on build version."
                      info "Nothing to fix here: it needs a rebuilt distro package."
                      PROBLEMS=$((PROBLEMS + 1)) ;;
    esac
    # Which widget style loads is a separate question, and it is NOT
    # QT_STYLE_OVERRIDE: plasma-integration applies kdeglobals [KDE]
    # widgetStyle after Qt has honoured the variable.
    ws=$(awk '/^\[KDE\]/{f=1;next} /^\[/{f=0} f&&/^widgetStyle=/{sub(/^widgetStyle=/,"");print;exit}' \
         "${XDG_CONFIG_HOME:-$HOME/.config}/kdeglobals" 2>/dev/null)
    [ -n "$ws" ] && info "kdeglobals [KDE] widgetStyle = $ws (this decides menu shape)"
fi

# ── 6. hand-edited system files ──────────────────────────────────────────
# Two files under /etc are edited by hand on this machine. A package update
# can replace either and leave a .rpmnew behind, silently reverting the fix.
box "hand-edited /etc files"

pamf=/etc/pam.d/sddm
if [ ! -f "$pamf" ]; then
    warn "$pamf missing — unexpected"
else
    sa=$(grep -nE '^session[[:space:]]+include[[:space:]]+system-auth' "$pamf" | head -1 | cut -d: -f1)
    kw=$(grep -nE '^-?session.*pam_kwallet5\.so' "$pamf" | head -1 | cut -d: -f1)
    if [ -z "$kw" ]; then
        warn "no pam_kwallet5 session line in $pamf"
    elif [ -z "$sa" ]; then
        warn "no 'session include system-auth' line in $pamf"
    elif [ "$kw" -gt "$sa" ]; then
        ok "pam_kwallet runs after pam_systemd (line $kw > $sa)"
    else
        bad "pam_kwallet runs BEFORE system-auth (line $kw < $sa) — reverted"
        info "ksecretd then starts with no XDG_RUNTIME_DIR and exits."
        info "Move the pam_kwallet session lines below 'session include system-auth'."
        info "A backup of the fixed file may be at ${pamf}.bak-20260921"
        PROBLEMS=$((PROBLEMS + 1))
    fi
fi

ddc=/etc/sddm.conf.d/10-displayserver.conf
if grep -qs '^DisplayServer=x11$' "$ddc"; then
    ok "sddm pinned to DisplayServer=x11"
else
    bad "$ddc missing or changed — logout will black-screen again"
    info "sddm 0.21 defaults to x11-user, which crashes the greeter on logout."
    info "Recreate it with:  [General]  /  DisplayServer=x11"
    info "Recovery if it happens: Ctrl+Alt+F3, sudo systemctl restart sddm"
    PROBLEMS=$((PROBLEMS + 1))
fi

leftovers=$(find /etc/pam.d /etc/sddm.conf.d -maxdepth 1 \
            \( -name '*.rpmnew' -o -name '*.rpmsave' \) 2>/dev/null)
if [ -n "$leftovers" ]; then
    warn "package updates left these behind — compare them against the live files:"
    printf '%s\n' "$leftovers" | sed 's/^/       /'
else
    ok "no .rpmnew/.rpmsave left under /etc/pam.d or /etc/sddm.conf.d"
fi

# ── 7. secret service ────────────────────────────────────────────────────
# Distinct from the KWallet password prompt. The prompt is a known ksecretd
# bug and merely annoying; the service being ABSENT means Mailspring, Proton
# Bridge and browsers cannot store credentials at all.
box "secret service"

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    ok "no session bus — skipping (run this inside the session)"
elif gdbus call --session --dest org.freedesktop.DBus \
        --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.NameHasOwner org.freedesktop.secrets \
        2>/dev/null | grep -q true; then
    ok "org.freedesktop.secrets is served"
    if journalctl -b -t ensure-secret-service --no-pager 2>/dev/null \
         | grep -q "unlocked via kwallet-pam handoff"; then
        ok "unlocked by kwallet-pam — no password prompt this login"
    else
        info "served by the fallback, so KWallet asked for a password once."
        info "Known ksecretd pam-login bug; not fixable from this side."
    fi
else
    bad "org.freedesktop.secrets has NO owner — credential storage is broken"
    info "Run:  ~/.local/bin/ensure-secret-service"
    PROBLEMS=$((PROBLEMS + 1))
fi

# ── 8. is a reboot required, and how urgently ────────────────────────────
# This is the check that was missing, and it is the one that matters most
# right after an update. On 2026-09-14 every known breakage had been handled
# and awesome was fine, yet the session went black mid-afternoon: glib and Qt
# had been REPLACED underneath running processes, and quickshell (902
# mapped-but-deleted regions) aborted the moment it needed a fresh page,
# taking the wallpaper and bar with it. Nothing reports that state; you have
# to go looking. A library update leaves every running process holding files
# that no longer exist, and glibc in particular is linked by everything.
box "reboot needed?"

REBOOT=0

running_kernel=$(uname -r)
newest_kernel=$(rpm -q --qf '%{VERSION}-%{RELEASE}\n' kernel-desktop 2>/dev/null | sort -V | tail -1)
if [ -n "$newest_kernel" ] && [ "${running_kernel%%-*}" != "${newest_kernel%%-*}" ]; then
    warn "kernel: running ${running_kernel}, installed ${newest_kernel}"
    info "the new kernel and its firmware are not active until you reboot"
    REBOOT=1
else
    ok "kernel: running the newest installed (${running_kernel})"
fi

# Count processes holding replaced libraries. Capped so this stays fast on a
# busy session; the count only needs to be indicative, not exact.
stale=0; worst=""; worstn=0
for pid in $(pgrep -u "$USER" . 2>/dev/null | head -400); do
    n=$(grep -c '(deleted)' "/proc/$pid/maps" 2>/dev/null) || continue
    case "$n" in ''|0) continue ;; esac
    stale=$((stale + 1))
    if [ "$n" -gt "$worstn" ]; then
        worstn=$n
        worst="$(ps -o comm= -p "$pid" 2>/dev/null) (pid $pid)"
    fi
done

if [ "$stale" -eq 0 ]; then
    ok "no processes are holding replaced libraries"
else
    warn "$stale process(es) are running on libraries that no longer exist"
    [ -n "$worst" ] && info "worst: $worst with $worstn mapped-but-deleted regions"
    info "They work until they touch something needing a fresh page, then die."
    info "quickshell going this way is what blacked out the session on 2026-09-14."
    REBOOT=1
fi

if [ "$REBOOT" -eq 1 ]; then
    ylw "  --> REBOOT once the checks above are clean."
fi

# ── Summary ──────────────────────────────────────────────────────────────
echo
if [ "$PROBLEMS" -eq 0 ]; then
    if [ "${REBOOT:-0}" -eq 1 ]; then
        ylw "╔════════════════════════════════════════════╗"
        ylw "║ Nothing broken, but a REBOOT is needed      ║"
        ylw "╚════════════════════════════════════════════╝"
    else
        grn "╔════════════════════════════════════════════╗"
        grn "║ Nothing outstanding, no reboot needed       ║"
        grn "╚════════════════════════════════════════════╝"
    fi
else
    red "╔═════════════════════════════════════╗"
    red "║ $(printf '%-35s' "$PROBLEMS item(s) need attention above") ║"
    red "╚═════════════════════════════════════╝"
    echo
    ylw "  Do NOT reboot into awesome until the lgi check passes — if it fails,"
    ylw "  awesome will not start and you will need a TTY (Ctrl+Alt+F2) to recover."
    ylw "  Session log, which SDDM overwrites on every login:"
    info "cp ~/.local/share/sddm/xorg-session.log /tmp/awesome-fail.log"
fi
echo
exit "$PROBLEMS"
